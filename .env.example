# LLM (free tier). Bỏ trống GEMINI_API_KEY => chạy chế độ local (câu trả lời dựng bằng mẫu)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER=auto            # auto | gemini | local

# Embedding
EMBED_MODEL=BAAI/bge-m3      # hoặc intfloat/multilingual-e5-large
EMBEDDER=bge-m3              # đặt "hash" CHỈ để test offline

# Qdrant: bỏ trống = chạy nhúng trong tiến trình (:memory:)
QDRANT_URL=                  # ví dụ http://localhost:6333

COVERAGE_MIN=0.5
AMBIGUITY_RATIO=0.8
